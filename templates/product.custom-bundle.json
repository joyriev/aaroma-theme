        "review_QpAqbF": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/pinkm.png",
            "content": "<p>\"Blij met Aaroma. De geur lijkt sterk op het origineel en blijft goed hangen. Nette verpakking, mooi flesje. Uitstekende keuze voor wie kwaliteit zoekt voor een eerlijke prijs.\"</p>",
